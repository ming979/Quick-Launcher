{
  "name": "quick-launcher",
  "version": "1.0.0",
  "description": "快捷启动器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "launcher",
    "app",
    "quick"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "msgpackr": "^1.10.1"
  },
  "build": {
    "appId": "com.example.quicklaunch",
    "productName": "快捷启动",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
